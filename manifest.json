{
  "manifest_version": 3,
  "name": "Resistor",
  "description": "Creates resistance accessing distracting and addictive websites.",
  "version": "1.1.0",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["challenge.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}