{
  "name": "resistor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that puts distracting sites behind a mindful pause.",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "shots": "node scripts/screenshots.mjs",
    "publish:site": "node scripts/publish-site.mjs",
    "css": "tailwindcss -i styles/app.css -o src/ui/app.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "heroicons": "^2.2.0",
    "tailwindcss": "^4.3.3"
  }
}
